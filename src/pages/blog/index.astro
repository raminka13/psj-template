---
/** Índice del blog, página 1. Las siguientes viven en /blog/pagina/N. */
import BlogList from "@components/sections/BlogList.astro";
import Badge from "@components/ui/Badge.astro";
import Section from "@components/ui/Section.astro";
import SectionHeading from "@components/ui/SectionHeading.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { getAllTags, getPublishedPosts, paginatePosts, tagToSlug } from "@lib/blog";

const posts = await getPublishedPosts();
const page = paginatePosts(posts, 1);
const tags = await getAllTags();
---

<PageLayout
  pageType="CollectionPage"
  seo={{
    title: "Blog",
    description:
      "Artículos sobre fe, sabiduría y propósito para la vida diaria. Contenido práctico en español, sin relleno ni sermones largos.",
    keywords: ["blog cristiano en español", "artículos de fe", "reflexiones diarias"],
    breadcrumbs: [{ name: "Blog", href: "/blog" }],
  }}
>
  <Section spacing="sm">
    <SectionHeading
      eyebrow="Blog"
      title="Ideas para la semana"
      subtitle="Textos cortos y aplicables. Uno nuevo cada semana."
      as="h1"
      size="h1"
    />

    {
      tags.length > 0 && (
        <div class="mt-8 flex flex-wrap justify-center gap-2">
          {tags.map(({ tag, count }) => (
            <a href={`/blog/tag/${tagToSlug(tag)}`}>
              <Badge variant="neutral" size="sm">
                {tag} <span class="text-ink-subtle">{count}</span>
              </Badge>
            </a>
          ))}
        </div>
      )
    }
  </Section>

  <BlogList page={page} />
</PageLayout>
