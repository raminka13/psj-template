---
/**
 * ============================================================================
 *  <Seo /> — todo el <head> de SEO de una página
 * ============================================================================
 *  Se renderiza una sola vez, desde BaseLayout. Una página normal no lo usa
 *  directamente: le pasa `seo={{ ... }}` al layout y ya.
 *
 *  Emite: título, descripción, keywords, canónica, robots, Open Graph,
 *  Twitter Card, hreflang (si aplica) y UN bloque JSON-LD con todo el grafo.
 * ============================================================================
 */
import { site } from "@config/site";
import { buildGraph, serializeSchema, type SchemaNode } from "@lib/schema";
import { resolveSeo, type SeoProps } from "@lib/seo";

interface Props extends SeoProps {
  /** Tipo de WebPage en schema.org. */
  pageType?: "WebPage" | "CollectionPage" | "ItemPage" | "AboutPage" | "ContactPage";
  /** Entidades extra de schema: product(), course(), event(), videoObject(). */
  schemaExtra?: SchemaNode[];
  /** Color de la barra del navegador; por defecto site.themeColor. */
  themeColor?: string;
}

const { pageType, schemaExtra = [], themeColor, ...seoProps } = Astro.props;

const seo = resolveSeo(seoProps, Astro.url);
const jsonLd = serializeSchema(buildGraph({ seo, pageType, extra: schemaExtra }));

const alternates = Object.entries(site.alternateLocales);
---

{/* ── Básicos ───────────────────────────────────────────────────────────── */}
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
{seo.keywords.length > 0 && <meta name="keywords" content={seo.keywords.join(", ")} />}
<link rel="canonical" href={seo.canonical} />
<meta name="robots" content={seo.robots} />
<meta name="author" content={seo.author} />
<meta name="theme-color" content={themeColor ?? site.themeColor} />

{/* ── Idiomas alternativos ──────────────────────────────────────────────── */}
{
  alternates.length > 0 && (
    <>
      {alternates.map(([lang, href]) => (
        <link rel="alternate" hreflang={lang} href={href} />
      ))}
      <link rel="alternate" hreflang="x-default" href={seo.canonical} />
    </>
  )
}

{/* ── Open Graph (Facebook, WhatsApp, LinkedIn) ─────────────────────────── */}
<meta property="og:type" content={seo.type} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:site_name" content={seo.siteName} />
<meta property="og:locale" content={seo.locale} />
<meta property="og:image" content={seo.image} />
<meta property="og:image:alt" content={seo.imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{
  seo.type === "article" && (
    <>
      {seo.publishedTime && (
        <meta property="article:published_time" content={seo.publishedTime.toISOString()} />
      )}
      {seo.modifiedTime && (
        <meta property="article:modified_time" content={seo.modifiedTime.toISOString()} />
      )}
      <meta property="article:author" content={seo.author} />
      {seo.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

{/* ── Twitter / X ───────────────────────────────────────────────────────── */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.image} />
<meta name="twitter:image:alt" content={seo.imageAlt} />
{site.twitter && <meta name="twitter:site" content={site.twitter} />}

{/* ── Datos estructurados ───────────────────────────────────────────────── */}
{/* Un solo bloque con todo el @graph. Ver el porqué en src/lib/schema.ts. */}
<script type="application/ld+json" is:inline set:html={jsonLd} />
