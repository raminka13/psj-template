---
/**
 * Botón / enlace de acción.
 *
 * Renderiza <a> si recibe href y <button> si no. Esa distinción no es
 * cosmética: un <div> con onclick no se puede tabular, no responde a Enter y
 * el lector de pantalla no lo anuncia como algo accionable.
 *
 * Todas las variantes salen de tokens: cambiar --brand-primary en tokens.css
 * cambia el botón primario en toda la página.
 */
interface Props {
  variant?: "primary" | "secondary" | "outline" | "ghost";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  /** Ocupa todo el ancho disponible. Recomendado en móvil para el CTA. */
  block?: boolean;
  disabled?: boolean;
  /** Para enlaces externos: agrega target y rel de seguridad. */
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  block = false,
  disabled = false,
  external = false,
  class: className = "",
  ...rest
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-btn font-semibold " +
  // 120ms: el rango del feedback de pulsación es 100-160ms. Por encima de eso
  // el botón se siente desconectado del dedo, porque la respuesta llega
  // después de que la persona ya soltó.
  "transition-[background-color,color,border-color,box-shadow,transform] duration-[120ms] ease-out-soft " +
  "active:translate-y-px disabled:pointer-events-none disabled:opacity-50";

const variants = {
  primary: "bg-primary text-on-primary hover:bg-primary-hover shadow-brand hover:shadow-lg",
  secondary: "bg-secondary text-on-secondary hover:bg-secondary-hover",
  outline:
    "border border-line-strong bg-transparent text-ink hover:border-primary hover:text-primary",
  ghost: "bg-transparent text-ink hover:bg-primary-soft hover:text-primary",
};

const sizes = {
  sm: "h-9 px-4 text-sm",
  md: "h-11 px-6 text-base",
  lg: "h-14 px-8 text-lg",
};

const classes = [base, variants[variant], sizes[size], block ? "w-full" : "", className]
  .filter(Boolean)
  .join(" ");

// rel="noopener" evita que la página destino pueda manipular la nuestra
// mediante window.opener.
const externalAttrs = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

{
  href ? (
    <a
      href={href}
      class={classes}
      aria-disabled={disabled ? "true" : undefined}
      {...externalAttrs}
      {...rest}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} disabled={disabled} {...rest}>
      <slot />
    </button>
  )
}
