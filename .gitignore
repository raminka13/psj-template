dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.local

# macOS
.DS_Store

# editors
.vscode/*
!.vscode/extensions.json
.idea/

# NOTA: .claude/ y .agents/ SÍ se versionan a propósito.
# Los skills de diseño y CLAUDE.md son parte del template y deben viajar con
# cada copia que se saque de este repo.
#
# Los skills viven en .agents/skills/ y .claude/skills/ son symlinks hacia
# allá. Git guarda symlinks sin problema, pero en Windows hay que tener
# activado el modo desarrollador (o `git config core.symlinks true`) para que
# se restauren como enlaces y no como archivos de texto.

# Local Netlify folder
.netlify

# ── Impeccable ────────────────────────────────────────────────────────────
# .impeccable/config.json SÍ se versiona: es la config compartida del detector
# (hook activado, reglas ignoradas del proyecto) y debe viajar con el template.
#
# Estos dos NO, porque son de máquina: el manifiesto del hook con rutas locales
# y el registro de consentimiento de cada persona.
#
# Se declaran aquí a propósito aunque ya estén ignorados en esta máquina: uno
# lo cubre el gitignore global del usuario y el otro .git/info/exclude, y
# NINGUNO de los dos viaja al clonar. Quien saque una copia del template en
# otro equipo acabaría commiteando su config local.
.claude/settings.local.json
.impeccable/config.local.json
